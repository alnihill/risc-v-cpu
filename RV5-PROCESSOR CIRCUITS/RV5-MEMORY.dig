    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>This is a dual-port RAM. It supports reading and writing at address 1A
and reading at address 1B. I&apos;m using 1A for instruction operations and
1B for instruction reads.</string>
        </entry>
      </elementAttributes>
      <pos x="160" y="1480"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
