          <string>textFontSize</string>
          <int>16</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>If we&apos;re writing a half or byte, we
need to take the remaining bytes
of the old word and merge them
with our new bytes.</string>
        </entry>
      </elementAttributes>
      <pos x="200" y="1920"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
