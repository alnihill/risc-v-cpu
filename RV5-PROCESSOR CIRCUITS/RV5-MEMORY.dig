    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>This is where the debug module writes and branches to when
it wants to execute arbitrary code. It&apos;s split into pieces because
it is read by three things: the debug module, the instruction
decoder, and instruction execution.</string>
        </entry>
      </elementAttributes>
      <pos x="2160" y="1480"/>
