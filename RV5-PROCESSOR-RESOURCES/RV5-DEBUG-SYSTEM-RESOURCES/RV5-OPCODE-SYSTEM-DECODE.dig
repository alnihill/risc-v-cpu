      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>12</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>This block contains the actual logic.
I like to keep it encapsulated like
this because I synthesize it from a
script-generated LUT. This layout
lets me cleanly separate what is manually
authored and what is synthesized. What
if my opcode splitting and opcode description
were in there and I regenerated for some
reason?
That would suck! It would be gone!</string>
        </entry>
      </elementAttributes>
      <pos x="460" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>This parses the opcode field of the risc-v instruction.
Really, this field represents what is called the &quot;major opcode&quot;.
I think it&apos;s called &quot;opcode&quot; in instruction layout diagrams in the
spec for brevity.</string>
        </entry>
      </elementAttributes>
      <pos x="320" y="-20"/>
    </visualElement>
    <visualElement>
      <elementName>_RV5-OPCODE-SYSTEM-DECODE.dig</elementName>
      <elementAttributes/>
      <pos x="520" y="160"/>
    </visualElement>
