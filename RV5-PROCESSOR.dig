<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry>
      <string>romContent</string>
      <romList>
        <roms/>
      </romList>
    </entry>
    <entry>
      <string>preloadProgram</string>
      <boolean>true</boolean>
    </entry>
    <entry>
      <string>preloadProgramFile</string>
      <file>./firmware-out/firmware.bin</file>
    </entry>
  </attributes>
  <visualElements>
    <visualElement>
      <elementName>Clock</elementName>
      <elementAttributes>
        <entry>
          <string>runRealTime</string>
          <boolean>true</boolean>
        </entry>
        <entry>
          <string>Label</string>
          <string>clock</string>
        </entry>
        <entry>
          <string>Frequency</string>
          <int>5000</int>
        </entry>
      </elementAttributes>
      <pos x="-13560" y="-2920"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>10</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>Note: In the debug module I have
something set up to override
this clock to maximum when debug
work needs to be done.
It&apos;s definitely a hack but worth it
for the debugging performance.
So the clock speed that you set 
here really just dictates how 
fast it will go *most* of the time.
(Unless you disable that feature.)</string>
        </entry>
      </elementAttributes>
      <pos x="-13660" y="-2900"/>
    </visualElement>
    <visualElement>
      <elementName>Rectangle</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>50</int>
        </entry>
        <entry>
          <string>RectHeight</string>
          <int>12</int>
        </entry>
        <entry>
          <string>Label</string>
          <string>About the CPU</string>
        </entry>
        <entry>
          <string>RectWidth</string>
          <int>62</int>
        </entry>
      </elementAttributes>
      <pos x="-12860" y="-2060"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>This is a single-cycle RV32I processor. In addition to the base instruction set, it also implements
the Ziscr extension and contains a debug module.

Additionally, this is a Von Neumann architecture, and so instruction memory and data memory are
merged. This makes it look slightly different than some educational datapath diagrams you might
see, which sometimes show the Harvard style.</string>
        </entry>
      </elementAttributes>
      <pos x="-12840" y="-2040"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>TODO: 

scrap pipeline stage division - done

R_rs1 &amp; R_rs2 - done

op1 &amp; op2 for ALU instead of mod - done

tri-state for one-hot mux - done

PCU simplify: branch condition in control logic - done

alu_asel = 2 -&gt; Can be done via r0? - No, we would need a mux to select rs1,
so we would just be moving the mux somewhere else.

Startup script

Debug sep - done</string>
        </entry>
      </elementAttributes>
      <pos x="-14760" y="-2920"/>
